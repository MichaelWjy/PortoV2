# Copy to .env (local) or .env.production (server). Never commit real values.
# Validated at startup by lib/env.ts. See docs/ENVIRONMENT_VARIABLES.md.
# None of these are exposed to the browser (no NEXT_PUBLIC_ variables are used).

# --- Application --------------------------------------------------------------
# Public origin of the site, no trailing slash. Used for canonical URLs, sitemap and Auth.js callbacks.
APP_URL="http://localhost:3000"

# --- Database (server-only secret) --------------------------------------------------
# Local: docker compose -f compose.dev.yaml up -d
DATABASE_URL="postgresql://porto:porto_dev_password@localhost:5433/porto?schema=public"
# Supabase (or other managed Postgres): use the Session pooler URL (port 5432) with ?sslmode=require,
# download the provider's root certificate and point DATABASE_SSL_CA_FILE at it (verified TLS).
# DATABASE_SSL_CA_FILE="./certs/supabase-ca.crt"
# Used by compose.yaml to create the production database container.
POSTGRES_USER="porto"
POSTGRES_PASSWORD="change-me-long-random"
POSTGRES_DB="porto"

# --- Auth.js (server-only secret) ---------------------------------------------------
# Generate with: openssl rand -base64 48
AUTH_SECRET="replace-with-at-least-32-random-characters"
# Trust X-Forwarded-* from Nginx (the app port must not be reachable directly).
AUTH_TRUST_HOST="true"

# --- Google sign-in (required in production) -----------------------------------------------
# Google Cloud console > Google Auth Platform > Clients > Web application (see docs/SECURITY.md).
# Redirect URI: <APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
# Server-only secret; rotate by adding a second secret, deploying, then deleting the old one.
AUTH_GOOGLE_SECRET=""

# Development-only passwordless admin login for local work and E2E tests.
# Refused at startup when NODE_ENV=production.
AUTH_DEV_LOGIN="false"

# --- Privacy (server-only secret) -------------------------------------------------
# Salt for hashing IPs in rate limiting and daily analytics pseudonyms. openssl rand -hex 24
IP_HASH_SALT="replace-with-random-salt"

# --- Media storage --------------------------------------------------------------------
# "local" writes to LOCAL_STORAGE_DIR (mount a volume in Docker); "s3" uses any S3-compatible bucket.
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage/uploads"
# Required only when STORAGE_DRIVER=s3 (keys are server-only secrets).
S3_BUCKET=""
S3_REGION=""
# Omit for AWS; set for R2/MinIO/Spaces/Supabase, e.g. https://<account>.r2.cloudflarestorage.com
# Supabase Storage: https://<project-ref>.storage.supabase.co/storage/v1/s3 (keys: Storage > Settings > S3 access keys)
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# "true" for MinIO and some S3-compatible providers.
S3_FORCE_PATH_STYLE="false"
